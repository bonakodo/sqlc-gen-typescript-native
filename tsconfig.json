  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "erasableSyntaxOnly": true,
    "types": ["node"],
    "lib": ["ESNext", "DOM", "DOM.Iterable"]
