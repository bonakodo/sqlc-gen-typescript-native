    (i32.or (i32.or (i32.eq (global.get $tx_err) (i32.const 26)) (i32.eq (global.get $tx_err) (i32.const 27)))
      (i32.or (i32.eq (global.get $tx_err) (i32.const 30)) (i32.eq (global.get $tx_err) (i32.const 39)))))
    (then (call $tx_quote (global.get $tx_argp) (global.get $tx_argn)
      (if (result i32) (i32.eq (global.get $tx_err) (i32.const 12)) (then (i32.const 39)) (else (i32.const 34))))))
  (if (i32.eq (global.get $tx_err) (i32.const 12)) (then (call $tx_literal (i32.const 40))))
  (if (i32.eq (global.get $tx_err) (i32.const 27)) (then (call $tx_literal (i32.const 28))))
