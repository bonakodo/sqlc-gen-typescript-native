;; Diagnostic quoting deliberately does not interpret backslash escapes already
;; present in source. They describe the original token, not a decoded JS value.
(func $tx_quote (param $p i32) (param $n i32) (param $quote i32)
  (local $resultp i32) (local $resultn i32) (local $r i32)
  (if (i32.eq (local.get $quote) (i32.const 39))
    (then
      (call $rune (local.get $p) (i32.add (local.get $p) (local.get $n))) (local.set $r) drop
      (call $go_quote_rune (local.get $r)) (local.set $resultn) (local.set $resultp))
    (else (call $go_quote (local.get $p) (local.get $n)) (local.set $resultn) (local.set $resultp)))
  (call $tx_append (local.get $resultp) (local.get $resultn)))
(func $tx_format_error
  (global.set $tx_out (i32.const 31588352))
